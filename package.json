{
  "name": "proxmox-center",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:auth": "node scripts/setup.mjs --enable-auth",
    "dev:server": "cd apps/server && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev": "concurrently --raw \"npm run dev:server\" \"npm run dev:web\"",
    "build:server": "npm run build -w apps/server",
    "build:web": "npm run build -w apps/web",
    "build": "npm run build:server && npm run build:web",
    "start": "npm run start -w apps/server",
    "install:apps": "npm install -w apps/server -w apps/web"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=8"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
