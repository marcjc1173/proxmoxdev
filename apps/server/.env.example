PORT=4000
CORS_ORIGIN=*

# App-level auth (RBAC)
APP_AUTH_ENABLED=false
APP_JWT_SECRET=replace_with_long_random_secret
# Optional JSON seed users (legacy + supported)
# APP_USERS=[{"username":"admin","password":"change-me","role":"admin"}]
APP_USERS=
# Optional users store file path (default: apps/server/data/users.json)
APP_USERS_FILE=
# First-run bootstrap admin (recommended when APP_USERS is empty)
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Alarm engine settings
ALARMS_POLL_INTERVAL_SECONDS=30
ALARM_CPU_WARN_PERCENT=85
ALARM_MEM_WARN_PERCENT=90
ALARM_DISK_WARN_PERCENT=90
ALARM_STORAGE_WARN_PERCENT=90
ALARM_WEBHOOK_ENABLED=false
ALARM_WEBHOOK_URL=
# generic | slack | teams
ALARM_WEBHOOK_PROVIDER=generic
ALARM_WEBHOOK_RETRY_MAX=3
ALARM_WEBHOOK_RETRY_BACKOFF_MS=1000
ALARM_WEBHOOK_AUDIT_LIMIT=200

# Example: https://192.168.1.10:8006
PROXMOX_BASE_URL=https://YOUR_PROXMOX_IP:8006
PROXMOX_ALLOW_SELF_SIGNED=true

# Auth mode: token OR password
# token | password
PROXMOX_AUTH_MODE=token

# Token auth (recommended)
# Format token id: user@realm!tokenname
PROXMOX_API_TOKEN_ID=root@pam!api
PROXMOX_API_TOKEN_SECRET=replace_with_secret

# Password auth
PROXMOX_USERNAME=root
PROXMOX_PASSWORD=replace_with_password
PROXMOX_REALM=pam
